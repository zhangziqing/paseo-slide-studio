{
  "name": "slide-studio",
  "description": "Edit HTML slide presentations inside Paseo using its existing workspace connection.",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "prepare:editor": "node scripts/prepare.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tests/services.test.mjs",
    "check": "node scripts/prepare.mjs --check && npm run typecheck && npm test",
    "prepack": "npm run prepare:editor"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.0",
    "@types/node": "^22.0.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
